# LLM Providers (Optional / Fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Model Serving (vLLM)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# Vector Database (Qdrant)
