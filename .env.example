# Relational Database (PostgreSQL - Read-Only for Text-to-SQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vnfin_db
POSTGRES_USER=vnfin_readonly
POSTGRES_PASSWORD=

# Observability (Langfuse)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
